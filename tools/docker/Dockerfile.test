# Test runner image — mirrors the CircleCI `test` job environment as closely as
# possible so that a local `./tools/test.sh` run matches CI by construction.
#
# Base image and system packages are kept in sync with .circleci/config.yml:
#   - image:   cimg/python:3.13.11  (same Python + OS + font stack as CI)
#   - apt:     libcairo2, pango, harfbuzz  (thumbnails + PDF export tests)
# In addition we install `gettext` so translations can be compiled inside the
# container (the .mo files are not committed and several tests depend on them).
#
# Python dependencies are intentionally NOT installed here: the repository is
# bind-mounted at runtime and dependencies are installed into a cached virtualenv
# volume by tools/docker/test_entrypoint.sh, which keeps the image small and the
# editable install pointing at the mounted source tree.
FROM cimg/python:3.13.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcairo2 libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b gettext \
    && rm -rf /var/lib/apt/lists/*
# The container runs as the invoking host user (see the `user:` key in
# docker-compose.test.yml), whose uid is not known at build time and is neither
# `circleci` nor a member of its group. cimg (Ubuntu-based) creates the home
# directory mode 0750, so that uid would land in the "other" class with no
# search bit and could not traverse into the bind-mounted project or the venv
# volume (every absolute path below /home/circleci -> "Permission denied").
# Open the home directory for traversal, and pre-create the venv mountpoint
# world-writable so the same uid can populate the cached virtualenv (a fresh
# named volume inherits the mountpoint's permissions).
RUN chmod 0755 /home/circleci \
    && mkdir -p /home/circleci/venv \
    && chmod 0777 /home/circleci/venv
USER circleci

WORKDIR /home/circleci/project
