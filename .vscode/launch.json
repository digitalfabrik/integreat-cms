{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Django (with Docker)",
      "type": "debugpy",
      "request": "launch",
      "args": ["runserver", "--noreload"],
      "django": true,
      "justMyCode": false,
      "autoStartBrowser": false,
      "program": "${workspaceFolder}/integreat_cms/integreat-cms-cli",
      "cwd": "${workspaceFolder}",
      "env": {
        "INTEGREAT_CMS_DEBUG": "true",
        "DJANGO_SETTINGS_MODULE": "integreat_cms.core.docker_settings"
      },
      "preLaunchTask": "start-docker",
      "postDebugTask": "stop-docker"
    },
    {
      "name": "Python Debugger: Django (without Docker)",
      "type": "debugpy",
      "request": "launch",
      "args": ["runserver"],
      "django": true,
      "autoStartBrowser": false,
      "program": "${workspaceFolder}/integreat_cms/integreat-cms-cli",
      "cwd": "${workspaceFolder}",
      "env": {
        "INTEGREAT_CMS_DEBUG": "true",
        "DJANGO_SETTINGS_MODULE": "integreat_cms.core.settings"
      }
    },
    {
      "name": "cms tests debug (launch)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "docker",
      "args": ["compose", "-f", "docker-compose.test.yaml", "run", "--rm", "--remove-orphans", "cms", "tools/test.py"],
      "console": "integratedTerminal"
    }
  ]
}
